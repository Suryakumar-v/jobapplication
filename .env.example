# Copy to .env and edit. Never commit .env.
# Values here are the safe defaults; changing the safety flags stops the service at startup.

# --- API service ---
JOB_AUTOMATION_API_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
# Shared secret sent by n8n in the X-API-Key header. Generate a long random value.
# Example (PowerShell): -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
API_KEY=

# --- Workflow behaviour ---
JOB_MATCH_THRESHOLD=75
MAX_JOBS_PER_RUN=50
MAX_APPLICATIONS_PER_DAY=10
MANUAL_APPROVAL_REQUIRED=true
AUTOMATIC_SUBMISSION_ENABLED=false
# Seconds an approval token stays valid.
APPROVAL_TOKEN_EXPIRY=3600
# Optional fuzzy duplicate matching of descriptions (0 = off, 0.9 = recommended when on).
FUZZY_DUPLICATE_THRESHOLD=0

# --- AI (optional, advisory only, off by default) ---
AI_ENABLED=false
# none | mock (offline, deterministic) | openai_compatible (a chat-completions endpoint)
AI_PROVIDER=none
# openai_compatible only. Default is a local Ollama server. Only the job title, company and
# description are sent; never your profile, resume or answers.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
# Only if the endpoint needs one. Keep it here, never in workflows.
AI_API_KEY=
AI_TIMEOUT=60
AI_MAX_INPUT_CHARS=8000
# A non-local AI_BASE_URL is refused at startup unless this is true (and it must use https).
AI_ALLOW_REMOTE=false

# --- Storage (relative paths are resolved from the project root) ---
DATABASE_PATH=data/job_tracker.db
SCREENSHOT_DIRECTORY=screenshots
RESUME_DIRECTORY=resumes
EXPORT_DIRECTORY=exports
LOG_DIRECTORY=logs
CONFIG_DIRECTORY=config

# --- Playwright ---
PLAYWRIGHT_HEADLESS=false
# Milliseconds between actions while developing.
PLAYWRIGHT_SLOW_MO=250
# Milliseconds per navigation/action.
PLAYWRIGHT_TIMEOUT=30000
# Seconds a review browser stays open after the form is filled (not extended by activity).
PLAYWRIGHT_SESSION_TIMEOUT=900
# chromium (installed by scripts/install_playwright.py), or an installed chrome / msedge.
PLAYWRIGHT_BROWSER_CHANNEL=chromium
# Hosts the browser may open besides localhost. Leave empty until you deliberately opt in.
PLAYWRIGHT_ALLOWED_HOSTS=

# --- Docker Compose only ---
N8N_HOST_PORT=5678
API_HOST_PORT=8000
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC
