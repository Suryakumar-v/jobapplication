{
  "id": "jaWf07Approval",
  "name": "07 Manual Approval",
  "nodes": [
    {
      "id": "07000000-0000-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "07000000-0000-4000-8000-000000000002",
      "name": "Called By Master Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 200],
      "parameters": { "inputSource": "passthrough" }
    },
    {
      "id": "07000000-0000-4000-8000-000000000003",
      "name": "Use First Item Only",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [220, 200],
      "parameters": { "maxItems": 1 }
    },
    {
      "id": "07000000-0000-4000-8000-000000000004",
      "name": "Load Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "api_url",
              "type": "string",
              "value": "={{ $env.JOB_AUTOMATION_API_URL || 'http://host.docker.internal:8000' }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000005",
      "name": "List Applications Awaiting Approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 100],
      "alwaysOutputData": true,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.api_url }}/applications?status=AWAITING_APPROVAL&limit=200",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 30000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Job Automation API Key" }
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000006",
      "name": "Collect Queue",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1000, 100],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "items",
        "options": {}
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000007",
      "name": "Stage Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1260, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "stage", "type": "string", "value": "07_manual_approval" },
            {
              "id": "s2",
              "name": "awaiting_approval",
              "type": "number",
              "value": "={{ ($json.items || []).filter(a => a.application_id).length }}"
            },
            {
              "id": "s3",
              "name": "review_queue",
              "type": "array",
              "value": "={{ ($json.items || []).filter(a => a.application_id).map(a => ({ application_id: a.application_id, company: a.company, job_title: a.job_title, job_url: a.job_url, awaiting_approval_at: a.awaiting_approval_at })) }}"
            },
            {
              "id": "s4",
              "name": "note",
              "type": "string",
              "value": "Review each form in its browser window, fill any fields left for you, then run `python run.py approve <application_id>` in a terminal and type the approval text yourself. This workflow only lists the queue: it approves and submits nothing."
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "07000000-0000-4000-8000-000000000008",
      "name": "Note - Stage",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-20, -200],
      "parameters": {
        "content": "## 07 Manual Approval (review queue only)\nLists applications in AWAITING_APPROVAL via `GET /applications?status=AWAITING_APPROVAL`. Approval happens outside n8n: a person runs `python run.py approve <application_id>` and types `SUBMIT <application_id>`. No workflow calls an approval endpoint (the validator rejects any URL containing /approv or /submit).",
        "height": 150,
        "width": 720
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Load Configuration", "type": "main", "index": 0 }]]
    },
    "Called By Master Workflow": {
      "main": [[{ "node": "Use First Item Only", "type": "main", "index": 0 }]]
    },
    "Use First Item Only": {
      "main": [[{ "node": "Load Configuration", "type": "main", "index": 0 }]]
    },
    "Load Configuration": {
      "main": [[{ "node": "List Applications Awaiting Approval", "type": "main", "index": 0 }]]
    },
    "List Applications Awaiting Approval": {
      "main": [[{ "node": "Collect Queue", "type": "main", "index": 0 }]]
    },
    "Collect Queue": {
      "main": [[{ "node": "Stage Summary", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "jaWf10ErrHandler" },
  "active": false
}
