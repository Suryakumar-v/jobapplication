{
  "id": "jaWf03Duplicates",
  "name": "03 Duplicate Check",
  "nodes": [
    {
      "id": "03000000-0000-4000-8000-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "03000000-0000-4000-8000-000000000002",
      "name": "Example Job",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "job",
              "type": "object",
              "value": "{\"company\": \"Example Corp (synthetic)\", \"title\": \"Example Network Engineer\", \"job_url\": \"https://jobs.example.com/openings/example-1\", \"description\": \"Synthetic example posting. Replace this input with a real posting before use.\"}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "03000000-0000-4000-8000-000000000003",
      "name": "Called By Master Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 200],
      "parameters": { "inputSource": "passthrough" }
    },
    {
      "id": "03000000-0000-4000-8000-000000000004",
      "name": "Load Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "api_url",
              "type": "string",
              "value": "={{ $env.JOB_AUTOMATION_API_URL || 'http://host.docker.internal:8000' }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "03000000-0000-4000-8000-000000000005",
      "name": "Check Job Against Stored Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [740, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.api_url }}/jobs/check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.job) }}",
        "options": { "timeout": 30000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "", "name": "Job Automation API Key" }
      }
    },
    {
      "id": "03000000-0000-4000-8000-000000000006",
      "name": "Stage Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1000, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "s1", "name": "stage", "type": "string", "value": "03_duplicate_check" },
            {
              "id": "s2",
              "name": "check_result",
              "type": "string",
              "value": "={{ !$json.valid ? 'invalid' : ($json.is_duplicate ? 'duplicate' : 'unique') }}"
            },
            { "id": "s3", "name": "job_id", "type": "string", "value": "={{ $json.job_id || '' }}" },
            {
              "id": "s4",
              "name": "duplicate_reason",
              "type": "string",
              "value": "={{ $json.duplicate_reason || '' }}"
            },
            {
              "id": "s5",
              "name": "duplicate_of_job_id",
              "type": "string",
              "value": "={{ $json.duplicate_of_job_id || '' }}"
            },
            { "id": "s6", "name": "errors", "type": "array", "value": "={{ $json.errors || [] }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "03000000-0000-4000-8000-000000000007",
      "name": "Note - Stage",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-20, -200],
      "parameters": {
        "content": "## 03 Duplicate Check (dry run)\nSends one job (`job` field) to `POST /jobs/check`. The API validates, fingerprints and looks for duplicates (fingerprint, URL, external ID, company + title, description hash, existing application) without storing anything. Duplicates are also rejected automatically when a job is imported in workflow 01; this stage is for checking a job first.",
        "height": 160,
        "width": 720
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Example Job", "type": "main", "index": 0 }]]
    },
    "Example Job": {
      "main": [[{ "node": "Load Configuration", "type": "main", "index": 0 }]]
    },
    "Called By Master Workflow": {
      "main": [[{ "node": "Load Configuration", "type": "main", "index": 0 }]]
    },
    "Load Configuration": {
      "main": [[{ "node": "Check Job Against Stored Jobs", "type": "main", "index": 0 }]]
    },
    "Check Job Against Stored Jobs": {
      "main": [[{ "node": "Stage Summary", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "jaWf10ErrHandler" },
  "active": false
}
